# ── Demo content ─────────────────────────────────────────────────────
# Fresh installs start with an empty wiki. Flip to `true` on first boot
# to import the bundled sample pages from `examples/vault/` (visual
# language, postgres conventions, deployment checklist, etc.) for
# evaluation. Safe to leave on — bootstrap is idempotent and won't
# re-import pages that already exist.
SEED_EXAMPLES=false

# ── URL ingest ───────────────────────────────────────────────────────
# POST /api/raw/url lets users add a knowledge source by URL instead of
# uploading a file. The fetcher rejects private/loopback IPs and caps
# response size + duration. Tighten or loosen per deployment.
URL_INGEST_TIMEOUT_SECONDS=60
URL_INGEST_MAX_BYTES=52428800        # 50 MB
URL_INGEST_ALLOW_PRIVATE=false       # flip to true for intranet docs

# ── DB pool sizing (issue #10) ───────────────────────────────────────
# Raised from SQLAlchemy defaults (5 + 10) so a failing endpoint can't
# saturate the pool while the frontend retries it. Bump higher on
# busy deployments; the backend logs pool stats on startup.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800                 # seconds; bounces idle connections

# ── AI provider ──────────────────────────────────────────────────────
# All model inference is via API — no local models, no GPU/CUDA.
#
# Pick one chat-LLM provider. `anthropic` is the default; flip to
# `openai` to use OpenAI or any OpenAI-compatible endpoint (Azure
# OpenAI, Together AI, Groq, OpenRouter, Ollama, vLLM, LM Studio, ...).
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
CHAT_MODEL=claude-sonnet-4-6

# OpenAI / OpenAI-compatible (used when LLM_PROVIDER=openai)
#   OpenAI:           https://api.openai.com/v1
#   Azure OpenAI:     https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   Together AI:      https://api.together.xyz/v1
#   Groq:             https://api.groq.com/openai/v1
#   OpenRouter:       https://openrouter.ai/api/v1
#   DeepSeek:         https://api.deepseek.com/v1                 model: deepseek-chat
#   Moonshot / Kimi:  https://api.moonshot.cn/v1                  model: moonshot-v1-128k
#                     (international: https://api.moonshot.ai/v1)
#   MiniMax:          https://api.minimaxi.com/v1                 model: MiniMax-Text-01
#                     (legacy:        https://api.minimax.chat/v1 model: abab6.5s-chat)
#   Ollama (local):   http://host.docker.internal:11434/v1
#   vLLM/LM Studio:   http://host.docker.internal:8000/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embeddings (OpenAI-compatible API; used for RAG vector search).
# EMBEDDING_BASE_URL / EMBEDDING_API_KEY fall back to the OPENAI_* values
# above when blank, so one endpoint can serve both chat and embeddings.
# EMBEDDING_DIM MUST match the model (1536 for text-embedding-3-small).
# Changing the model/dim requires a re-embed:
#   docker compose exec backend alembic upgrade head
#   docker compose exec backend python -m app.scripts.backfill_embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Auth
AUTH_MODE=stub                        # 'stub' for dev (X-User-Email headers), 'oidc' for production
JWT_SECRET=change-me-in-prod-please   # used to sign session JWTs — long random string

# Static admin (issue #5). Set both to enable POST /api/auth/login as a
# username+password sign-in. Works in any AUTH_MODE — useful for the
# bootstrap account AND as an emergency break-glass if OIDC breaks.
# Keep ADMIN_PASSWORD strong; treat it like a database root password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# OIDC (issue #5). Required when AUTH_MODE=oidc unless ADMIN_EMAIL+
# ADMIN_PASSWORD are set as the sole auth path. Tested against GitLab;
# any spec-compliant IdP (Google, Microsoft, Okta, Auth0) should work.
OIDC_ISSUER=                          # e.g. https://gitlab.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback   # must match IdP registration
OIDC_SCOPES=openid email profile
DEFAULT_OIDC_ROLE=reader              # 'reader' or 'contributor' — applies to new OIDC users

# ── Gated artifact publishing (display.dev / Flowershow style) ──────
# Lets a wiki user right-click a page → "Publish as gated link" and get
# back a URL like /a/<short_id> that anyone in the company can view
# without going through the wiki chrome. See docs/ARTIFACTS.md.
ARTIFACTS_STORAGE_DIR=/data/artifacts
ARTIFACTS_MAX_BODY_BYTES=10485760     # 10 MB per artifact body
ARTIFACTS_ALLOW_PUBLIC=false          # set true to unlock visibility=public
ARTIFACTS_DEFAULT_EXPIRY_DAYS=        # blank = never auto-expire

# Database
POSTGRES_USER=wiki
POSTGRES_PASSWORD=wiki
POSTGRES_DB=wiki
